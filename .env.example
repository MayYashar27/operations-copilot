# Copy this file to .env and fill in values. Never commit .env.

# demo (default): read-only. Saved reports and investigations only; no AI calls.
# live: also lets THIS machine start new investigations (paid Claude calls).
#       Requires ANTHROPIC_API_KEY. Never use live mode on a public server.
APP_MODE=demo

# Only needed for live mode and for the scripts in scripts/.
ANTHROPIC_API_KEY=
