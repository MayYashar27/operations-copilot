# Copy this file to .env and fill in values. .env is git-ignored: never commit it.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# demo (default): read-only. Serves saved reports and saved investigations.
#                 No AI calls are made and no API key is needed.
# live:           also lets THIS machine start new AI investigations (paid
#                 Anthropic API calls). Requires ANTHROPIC_API_KEY.
#                 Never run live mode on a publicly reachable server.
APP_MODE=demo

# Your Anthropic API key. Only needed for live mode and for the scripts in scripts/.
# It is read from the environment on the server; never put it in code or the frontend.
ANTHROPIC_API_KEY=

# Optional: override where saved artifacts are read from (defaults shown).
# REPORTS_DIR=reports
# INVESTIGATIONS_DIR=investigations
